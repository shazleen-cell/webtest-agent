# Auto detect text files and perform LF normalization
* text=auto

# Text files: always LF, also on Windows
*.py    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.sh    text eol=lf

# Binary files: never change line endings, never try to diff or merge as text
*.xlsx  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.zip   binary
