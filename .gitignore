# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# Excel lock files (created while a workbook is open)
~$*

# Personal Claude Code settings (local permissions)
.claude/settings.local.json

# Test-account values (test user ID). Tracked files use placeholders like {TEST_USER_ID}.
website-tests/*/settings.local.md
# Exploration screenshots stay on this computer only (the LOGGED IN ones also show the player name)
website-tests/*/explore/

# Browser trace zips written by wdio-mcp on close_session
.trace/

# Test runs and results stay on this computer only (about 1 GB per run).
# Nothing under runs/ goes to git: not the run folders, not Results/ (report, results.xlsx, json/).
website-tests/*/runs/
